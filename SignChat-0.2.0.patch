+def _angles_batch(u: np.ndarray, v: np.ndarray) -> np.ndarray:
+    nu = np.linalg.norm(u, axis=-1)
+    nv = np.linalg.norm(v, axis=-1)
+    cos = np.einsum("...j,...j->...", u, v) / np.maximum(nu * nv, 1e-12)
+    return np.arccos(np.clip(cos, -1.0, 1.0))
+
