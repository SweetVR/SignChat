+    for label, info in per.items():
+        n = max(info["n"], 1)
+        conf = sorted(info["conf"].items(), key=lambda kv: -kv[1])
+        out[label] = {"acc": info["ok"] / n, "unknown": info["unknown"] / n, "n": info["n"],
+                      "confused_with": [(c, v / n) for c, v in conf]}
